<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/pixel_space_sm">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_value"
        style="@style/GameFoldPixel.Text.Numeric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/pixel_space_md"
        android:layout_marginTop="@dimen/pixel_space_md"
        tools:text="75%" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider"
        style="@style/GameFoldPixel.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/text_value"
        android:layout_marginBottom="@dimen/pixel_space_md"
        android:layout_marginLeft="@dimen/pixel_space_lg"
        android:layout_marginRight="@dimen/pixel_space_lg" />

</RelativeLayout>
