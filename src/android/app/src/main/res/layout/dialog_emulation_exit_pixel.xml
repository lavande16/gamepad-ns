<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/pixel_dialog_background"
    android:minWidth="@dimen/pixel_dialog_min_width"
    android:orientation="vertical"
    android:padding="@dimen/pixel_space_lg">

    <TextView
        style="@style/GameFoldPixel.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/emulation_exit"
        android:textColor="@color/pixel_text_dark" />

    <TextView
        style="@style/GameFoldPixel.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pixel_space_md"
        android:gravity="center"
        android:text="@string/emulation_exit_prompt"
        android:textColor="@color/pixel_text_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pixel_space_lg"
        android:orientation="horizontal">

        <Button
            android:id="@+id/continue_button"
            style="@style/GameFoldPixel.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/continue_button" />

        <Space
            android:layout_width="@dimen/pixel_space_sm"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/exit_button"
            style="@style/GameFoldPixel.Button.Danger"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/emulation_exit" />

    </LinearLayout>

</LinearLayout>
