<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/option_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pixel_space_sm"
    android:layout_marginHorizontal="@dimen/pixel_space_sm"
    android:background="@drawable/pixel_button_background"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/option_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/option_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/pixel_space_sm"
            android:layout_gravity="center_vertical"
            app:tint="@color/pixel_text_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="0dp"
            android:layout_marginStart="@dimen/pixel_space_md"
            android:layout_marginEnd="@dimen/pixel_space_sm"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/GameFoldPixel.Text.Label"
                android:id="@+id/option_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                tools:text="@string/install_prod_keys" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/GameFoldPixel.Text.Secondary"
                android:id="@+id/option_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:layout_marginTop="2dp"
                tools:text="@string/install_prod_keys_description" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/GameFoldPixel.Text.Value"
                android:id="@+id/option_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:ellipsize="none"
                android:requiresFadingEdge="horizontal"
                android:layout_marginTop="@dimen/pixel_space_xs"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="/tree/primary:Games" />

        </LinearLayout>

    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
