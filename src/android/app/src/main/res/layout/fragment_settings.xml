<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/GameFoldPixel.ContentPage">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_settings"
        style="@style/Widget.Eden.TransparentTopAppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false"
        android:background="@color/pixel_surface_slate_dark"
        android:touchscreenBlocksFocus="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_settings"
            style="@style/GameFoldPixel.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pixel_toolbar_height"
            android:touchscreenBlocksFocus="false"
            app:navigationIcon="@drawable/pixel_icon_back"
            app:navigationIconTint="@color/pixel_text_dark"
            app:titleTextColor="@color/pixel_text_dark" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="48dp"
        android:paddingTop="@dimen/pixel_space_sm"
        android:paddingBottom="@dimen/pixel_space_md"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
