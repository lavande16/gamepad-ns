<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/card_game_grid_compact"
        android:layout_width="166dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/pixel_game_cartridge_background"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/pixel_touch_target"
        android:padding="10dp"
        android:stateListAnimator="@null"
        android:transitionName="card_game_compact">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/image_game_screen_compact"
                android:layout_width="146dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/gamefold_brand_mark" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_game_title_compact"
                style="@style/GameFoldPixel.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/pixel_space_sm"
                android:textAlignment="center"
                android:textColor="@color/pixel_text_dark"
                android:textStyle="bold"
                tools:text="The Legend of Zelda: Skyward Sword" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
