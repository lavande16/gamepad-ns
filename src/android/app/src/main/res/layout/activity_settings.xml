<?xml version="1.0" encoding="utf-8"?>
<org.yuzu.yuzu_emu.views.GameFoldShellLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixel_background_deep">

    <org.yuzu.yuzu_emu.views.GameFoldViewportLayout
        android:id="@+id/gamefold_display_stage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/pixel_home_surface">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            tools:layout="@layout/fragment_settings" />

        <View
            android:id="@+id/navigation_bar_shade"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

    </org.yuzu.yuzu_emu.views.GameFoldViewportLayout>
</org.yuzu.yuzu_emu.views.GameFoldShellLayout>
