<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingTop="22dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/text_no_games_title"
        style="@style/GameFoldPixel.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/gamefold_no_games_title"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@id/button_close_no_games"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/button_close_no_games"
        style="@style/GameFoldPixel.Text.Title"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/pixel_header_action_button_background"
        android:clickable="true"
        android:contentDescription="@string/close"
        android:focusable="true"
        android:gravity="center"
        android:text="×"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_no_games_detail"
        style="@style/GameFoldPixel.Text.Value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="4"
        android:text="@string/gamefold_no_games_detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_no_games_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_open_website"
        style="@style/GameFoldPixel.Button.Action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/gamefold_open_website"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_no_games_detail" />

</androidx.constraintlayout.widget.ConstraintLayout>
