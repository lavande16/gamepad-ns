<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pixel_space_xs"
    style="@style/GameFoldPixel.ListItem"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/pixel_space_sm"
    android:paddingBottom="@dimen/pixel_space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/pixel_space_sm"
            android:layout_marginEnd="@dimen/pixel_space_md"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            app:tint="@color/pixel_text_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_setting_name"
                style="@style/GameFoldPixel.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                tools:text="Setting Name" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_setting_description"
                style="@style/GameFoldPixel.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textAlignment="viewStart"
                tools:text="@string/app_disclaimer" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_setting_value"
                style="@style/GameFoldPixel.Text.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textAlignment="viewStart"
                tools:text="1x" />

            <Button
                android:id="@+id/button_clear"
                style="@style/GameFoldPixel.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pixel_space_md"
                android:visibility="gone"
                android:text="@string/use_global_setting"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
