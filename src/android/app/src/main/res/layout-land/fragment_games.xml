<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pixel_home_stage_background"
    android:padding="0dp">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gamefold_ns_launcher_icon" />

            </com.google.android.material.card.MaterialCardView>

            <org.yuzu.yuzu_emu.views.PixelWordmarkView
                android:id="@+id/gamefold_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pixel_space_sm"
                android:clickable="false"
                android:contentDescription="GAMEPAD NS"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/gamefold_home_brand_name"
                android:textColor="@color/pixel_home_text"
                app:pixelShadowEnabled="false"
                app:pixelWordmarkBold="true"
                app:pixelWordmarkColor="@color/pixel_home_text" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dual_screen_toggle_button"
                android:layout_width="@dimen/pixel_touch_target"
                android:layout_height="@dimen/pixel_touch_target"
                android:minWidth="@dimen/pixel_touch_target"
                android:minHeight="@dimen/pixel_touch_target"
                android:background="@android:color/transparent"
                android:contentDescription="@string/gamefold_dual_screen_toggle"
                android:nextFocusRight="@id/information_button"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/gamefold_dual_screen_off"
                android:tint="@null"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/information_button"
                style="@style/GameFoldPixel.ImageIconButton"
                android:layout_marginStart="@dimen/pixel_space_sm"
                android:background="@drawable/pixel_resize_button_normal"
                android:contentDescription="@string/gamepad_resize_toggle"
                android:nextFocusLeft="@id/dual_screen_toggle_button"
                android:nextFocusRight="@id/settings_button"
                android:src="@drawable/pixel_icon_resize"
                android:tint="@android:color/white"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp" />

            <ImageButton
                android:id="@+id/settings_button"
                style="@style/GameFoldPixel.ImageIconButton.Action"
                android:background="@drawable/pixel_header_action_button_background"
                android:layout_marginStart="@dimen/pixel_space_sm"
                android:contentDescription="@string/home_settings"
                android:nextFocusLeft="@id/information_button"
                android:src="@drawable/pixel_icon_settings"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp" />

        </LinearLayout>

    </FrameLayout>

    <org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:background="@android:color/transparent"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/notice_text"
                style="@style/GameFoldPixel.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="@dimen/pixel_space_lg"
                android:background="@drawable/pixel_panel_background"
                android:drawableTop="@drawable/pixel_state_empty_library"
                android:drawablePadding="@dimen/pixel_space_md"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="4"
                android:padding="@dimen/pixel_space_md"
                android:text="@string/empty_gamelist"
                android:textAlignment="center"
                android:textColor="@color/pixel_text_dark"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="@dimen/pixel_space_sm"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/quick_start_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/GameFoldPixel.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quick_start"
                        android:textColor="@color/pixel_text_dark"
                        android:textSize="18sp" />

                    <ImageButton
                        android:id="@+id/orientation_toggle_button"
                        style="@style/GameFoldPixel.ImageIconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/gamefold_orientation_toggle"
                        android:padding="4dp"
                        android:src="@drawable/pixel_icon_orientation_toggle"
                        android:tint="@null" />

                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/GameFoldPixel.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/quick_start_instructions"
                    android:textColor="@color/pixel_text_dark"
                    android:textSize="13sp" />

            </LinearLayout>

        </RelativeLayout>

    </org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout>

    <Button
        android:id="@+id/launch_qlaunch"
        style="@style/GameFoldPixel.Button.Action"
        android:layout_width="wrap_content"
        android:layout_margin="@dimen/pixel_space_md"
        android:contentDescription="@string/qlaunch_applet"
        android:text="@string/qlaunch_applet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
