<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GameFoldPixel.Text" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/pixel_text_dark</item>
        <item name="android:textSize">@dimen/pixel_text_body</item>
    </style>

    <style name="GameFoldPixel.Text.Title" parent="GameFoldPixel.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/pixel_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GameFoldPixel.Text.Label" parent="GameFoldPixel.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/pixel_text_label</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GameFoldPixel.Text.Caption" parent="GameFoldPixel.Text">
        <item name="android:textSize">@dimen/pixel_text_caption</item>
    </style>

    <style name="GameFoldPixel.Text.Numeric" parent="GameFoldPixel.Text.Label">
        <item name="android:fontFamily">monospace</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="GameFoldPixel.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/pixel_button_height</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:minWidth">@dimen/pixel_touch_target</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:outlineAmbientShadowColor">@color/pixel_border_ink</item>
        <item name="android:outlineSpotShadowColor">@color/pixel_border_ink</item>
        <item name="android:paddingStart">@dimen/pixel_space_md</item>
        <item name="android:paddingEnd">@dimen/pixel_space_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pixel_button_text_color</item>
        <item name="android:textSize">@dimen/pixel_text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/pixel_surface_slate</item>
        <item name="cornerRadius">0dp</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/pixel_focus</item>
        <item name="strokeColor">@color/pixel_border_ink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="GameFoldPixel.Button.Danger" parent="GameFoldPixel.Button">
        <item name="android:textColor">@color/pixel_text_light</item>
        <item name="backgroundTint">@color/pixel_danger</item>
        <item name="iconTint">@color/pixel_text_light</item>
    </style>

    <style name="GameFoldPixel.Button.Action" parent="GameFoldPixel.Button">
        <item name="android:textColor">@color/pixel_text_light</item>
        <item name="android:outlineAmbientShadowColor">@color/pixel_action_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/pixel_action_shadow</item>
        <item name="backgroundTint">@color/pixel_action</item>
        <item name="iconTint">@color/pixel_text_light</item>
    </style>

    <style name="GameFoldPixel.Panel" parent="">
        <item name="android:background">@drawable/pixel_panel_background</item>
        <item name="android:padding">@dimen/pixel_space_md</item>
    </style>

    <style name="GameFoldPixel.ContentPage" parent="">
        <item name="android:background">@color/pixel_home_surface</item>
    </style>

    <style name="GameFoldPixel.SectionTitle" parent="GameFoldPixel.Text.Label">
        <item name="android:background">@drawable/pixel_section_header_background</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/pixel_space_md</item>
        <item name="android:paddingEnd">@dimen/pixel_space_md</item>
        <item name="android:textColor">@color/pixel_text_light</item>
    </style>

    <style name="GameFoldPixel.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/pixel_surface_slate</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/pixel_border_ink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="GameFoldPixel.DialogPanel" parent="GameFoldPixel.Panel">
        <item name="android:background">@drawable/pixel_dialog_background</item>
        <item name="android:minWidth">@dimen/pixel_dialog_min_width</item>
        <item name="android:padding">@dimen/pixel_space_lg</item>
    </style>

    <style name="GameFoldPixel.ListItem" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/pixel_list_item_height</item>
        <item name="android:background">@drawable/pixel_list_item_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/pixel_space_md</item>
        <item name="android:paddingEnd">@dimen/pixel_space_md</item>
    </style>

    <style name="GameFoldPixel.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/pixel_surface_slate_dark</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">@dimen/pixel_toolbar_height</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="contentInsetStart">8dp</item>
        <item name="contentInsetEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="navigationIconTint">@color/pixel_text_dark</item>
        <item name="titleTextColor">@color/pixel_text_dark</item>
        <item name="android:textColor">@color/pixel_text_dark</item>
        <item name="titleTextAppearance">@style/GameFoldPixel.Text.Title</item>
    </style>

    <style name="GameFoldPixel.Text.Title.Light" parent="GameFoldPixel.Text.Title">
        <item name="android:textColor">@color/pixel_text_light</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="GameFoldPixel.Text.Secondary" parent="GameFoldPixel.Text">
        <item name="android:textColor">@color/pixel_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="GameFoldPixel.Text.Value" parent="GameFoldPixel.Text.Numeric">
        <item name="android:textColor">@color/pixel_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="GameFoldPixel.Text.Value.Light" parent="GameFoldPixel.Text.Value">
        <item name="android:textColor">@color/pixel_text_light</item>
    </style>

    <!--
        Drawable-backed icon controls are intentionally split from MaterialButton controls.
        A shared style here used to let each widget class apply its own implicit
        background tint, flattening the face and the offset shadow into one colour.
    -->
    <style name="GameFoldPixel.ImageIconButton" parent="">
        <item name="android:layout_width">@dimen/pixel_touch_target</item>
        <item name="android:layout_height">@dimen/pixel_touch_target</item>
        <item name="android:minWidth">@dimen/pixel_touch_target</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:background">@drawable/pixel_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/pixel_text_dark</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GameFoldPixel.ImageIconButton.Action" parent="GameFoldPixel.ImageIconButton">
        <item name="android:background">@drawable/pixel_action_button_background</item>
        <item name="android:tint">@color/pixel_text_light</item>
    </style>

    <style name="GameFoldPixel.MaterialLayerIconButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/pixel_touch_target</item>
        <item name="android:layout_height">@dimen/pixel_touch_target</item>
        <item name="android:minWidth">@dimen/pixel_touch_target</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:background">@drawable/pixel_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:padding">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/pixel_text_dark</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GameFoldPixel.MaterialLayerIconButton.Action" parent="GameFoldPixel.MaterialLayerIconButton">
        <item name="android:background">@drawable/pixel_action_button_background</item>
        <item name="iconTint">@color/pixel_text_light</item>
    </style>

    <style name="GameFoldPixel.MaterialIconButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/pixel_touch_target</item>
        <item name="android:layout_height">@dimen/pixel_touch_target</item>
        <item name="android:minWidth">@dimen/pixel_touch_target</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="backgroundTint">@color/pixel_surface_slate</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/pixel_text_dark</item>
        <item name="rippleColor">@color/pixel_focus</item>
        <item name="strokeColor">@color/pixel_border_ink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="GameFoldPixel.Button.Compact" parent="GameFoldPixel.Button">
        <item name="android:layout_height">@dimen/pixel_touch_target</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="GameFoldPixel.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">@dimen/pixel_switch_width</item>
        <item name="android:layout_height">@dimen/pixel_touch_target</item>
        <item name="android:minWidth">@dimen/pixel_switch_width</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:thumb">@drawable/pixel_switch_thumb</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">@dimen/pixel_switch_width</item>
        <item name="track">@drawable/pixel_switch_track</item>
    </style>

    <style name="GameFoldPixel.Slider" parent="Widget.Material3.Slider">
        <item name="haloColor">@color/pixel_transparent</item>
        <item name="haloRadius">0dp</item>
        <item name="thumbColor">@color/pixel_focus</item>
        <item name="thumbRadius">8dp</item>
        <item name="tickVisible">false</item>
        <item name="trackColorActive">@color/pixel_focus</item>
        <item name="trackColorInactive">@color/pixel_surface_slate_dark</item>
        <item name="trackHeight">8dp</item>
    </style>

    <style name="GameFoldPixel.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/pixel_surface_slate</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxStrokeColor">@color/pixel_input_stroke_color</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">4dp</item>
        <item name="hintTextColor">@color/pixel_text_secondary</item>
    </style>

    <style name="GameFoldPixel.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:textColor">@color/pixel_text_dark</item>
        <item name="android:textColorHint">@color/pixel_text_secondary</item>
        <item name="android:textSize">@dimen/pixel_text_body</item>
    </style>

    <style name="GameFoldPixel.ShapeAppearance" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="GameFoldPixel.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:minHeight">@dimen/pixel_touch_target</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">@dimen/pixel_space_md</item>
        <item name="android:paddingEnd">@dimen/pixel_space_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pixel_text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/pixel_surface_slate</item>
        <item name="cornerRadius">0dp</item>
        <item name="rippleColor">@color/pixel_focus</item>
        <item name="strokeColor">@color/pixel_border_ink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="GameFoldPixel.DialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackground">@color/pixel_surface_slate</item>
        <item name="android:textColorPrimary">@color/pixel_text_dark</item>
        <item name="android:textColorSecondary">@color/pixel_text_secondary</item>
        <item name="colorPrimary">@color/pixel_action</item>
        <item name="colorOnPrimary">@color/pixel_text_light</item>
        <item name="colorOnSurface">@color/pixel_text_dark</item>
        <item name="colorOutline">@color/pixel_border_ink</item>
        <item name="colorSurface">@color/pixel_surface_slate</item>
        <item name="backgroundInsetStart">0dp</item>
        <item name="backgroundInsetEnd">0dp</item>
        <item name="backgroundInsetTop">0dp</item>
        <item name="backgroundInsetBottom">0dp</item>
        <item name="shapeAppearanceMediumComponent">@style/GameFoldPixel.ShapeAppearance</item>
        <item name="buttonBarPositiveButtonStyle">@style/GameFoldPixel.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/GameFoldPixel.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/GameFoldPixel.DialogButton</item>
    </style>

    <style name="GameFoldPixel.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/pixel_dialog_background</item>
        <item name="backgroundTint">@color/pixel_surface_slate</item>
        <item name="shapeAppearance">@style/GameFoldPixel.ShapeAppearance</item>
        <item name="shapeAppearanceOverlay">@style/GameFoldPixel.ShapeAppearance</item>
    </style>

    <style name="GameFoldPixel.BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:colorBackground">@color/pixel_surface_slate</item>
        <item name="bottomSheetStyle">@style/GameFoldPixel.BottomSheet</item>
        <item name="colorOnSurface">@color/pixel_text_dark</item>
        <item name="colorSurface">@color/pixel_surface_slate</item>
        <item name="shapeAppearanceMediumComponent">@style/GameFoldPixel.ShapeAppearance</item>
    </style>
</resources>
